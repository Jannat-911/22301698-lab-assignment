++USER_CFLAGS += -m32
++
++# generate code for 32-bit environment
++USER_ASFLAGS := $(USER_CFLAGS)
++
++# FreeBSD ld wants ``elf_i386_fbsd''
++USER_LDFLAGS += -m $(shell $(LD) -V | grep elf_i386 2>/dev/null)
++
++# do not link with the host standard library files
